FROM node:26-alpine

RUN apk add --no-cache \
        git \
        ripgrep \
        curl \
        ca-certificates \
        openssh-client \
    && rm -rf /var/lib/apt/lists/* \
        /var/cache/apk/* \
        /usr/share/man \
        /tmp/*

RUN npm install -g @earendil-works/pi-coding-agent

USER node
WORKDIR /workspace

CMD ["pi"]
